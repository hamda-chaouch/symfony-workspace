                    <span class="tech-chip">Telegram Bot</span>
                    <span class="tech-chip">MariaDB</span>
                </div>

                <div class="project-card-footer">
                    <span class="revenue-badge">
                        <i class="fas fa-handshake"></i> Revenue-share available
                    </span>
                </div>
            </div>

            <!-- ---------------------------------------------------
                 FLAGSHIP 2: AI Factory Hub (IN DEVELOPMENT)
                 --------------------------------------------------- -->
            <div class="flagship-card">
                <div class="d-flex justify-content-between align-items-start">
