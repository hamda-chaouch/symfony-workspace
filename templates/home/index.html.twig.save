{% extends 'base.html.twig' %}

{% block title %}Development Engineering – Software & Mechatronics Solutions{% endblock %}

{% block body %}

    <!-- Sticky Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
       {# <div class="container"> #}
            <a class="navbar-brand" href="#">Welcome</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link active" href="#home">HOME</a></li>
                    <li class="nav-item"><a class="nav-link" href="/apps">All PROJECTS</a></li>
 		    <li class="nav-item"><a class="nav-link" href="/vr-studio">VR/XR STUDIO</a></li>
  		    <li class="nav-item"><a class="nav-link" href="#robotics">ROBOTICS</a></li>
                    <li class="nav-item"><a class="nav-link" href="/services">SERVICES</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">ABOUT US</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">CONTACT</a></li>
                </ul>
            </div>
        {# </div> #}
    </nav>

    <!-- Header -->
    <header class="bg-primary text-white text-center py-5">
        <div> {# class="container"> #}
            <h1>Development Engineering</h1>
            <p class="lead">Custom software development | custom Mechatronic systems | VR/XR apps design | VR/XR Accessories design | Business Automation.</p>
            <a href="/apps" class="btn btn-light btn-lg">View Our Projects</a>
        </div>
    </header>

    <!-- About Section -->
    <section id="about">
        <div class="container">
            <div class="row align-items-center">
                <h2>About Us</h2>
                {#  <div class="col-lg-4 text-center mb-4 mb-lg-0">
                    <h2>About Us</h2>
                </div> #}
                <div class="col-lg-8">
                    <img src="{{ asset('images/banner.jpg') }}" alt="Hamda Chaouch – Founder" class="img-fluid" style="max-width: 200px;">
                    <p>Through Development Engineering Services, We work on innovative projects ranging from industrial automation and custom electronics to immersive VR experiences
                         and software development.
                      We enjoy sharing knowledge, mentoring students, building communities, and exploring new technologies that bridge engineering and creativity.</p> 
                </div>
                <div class="col-lg-4 text-center mb-4 mb-lg-0">
                    <p><strong>Hamda Chaouch</strong> – Mechatronics Engineer, developer, maker, and VR enthusiast passionate about transforming ideas into real-world solutions.
                        With over<strong> 17 years</strong> of experience in<strong> Qt/C++ development</strong> and<strong> Mechatronics
</strong>|<strong> Embedded Systems</strong> and<strong> IoT Solutions</strong> |<strong> AI</strong> | <strong> VR/XR apps/accessories design</strong>.</p>
                    <img src="{{ asset('images/portrait.jpg') }}" alt="Hamda Chaouch – Founder" class="img-fluid rounded-circle" style="max-width: 200px;">
                </div>
            </div>
        </div>
    </section>  

    <!-- Skills Section -->
    <section>
        <div class="bg-light container">
            <h2 class="text-center mb-4">Technologies & Skills</h2>
            <div class="row text-center">
                <div class="col-md-3 mt-3">🤖⚙️ Mechatronics</div>
                <div class="col-md-3 mt-3">🔌 uCs: PIC/ATMEGA/Arduino/STM32</div>
                <div class="col-md-3 mt-3">🍓 Raspberry Pi</div>
                <div class="col-md-3 mt-3">🎮 Unity 3D</div>
                <div class="col-md-3 mt-3">🥽 Meta Quest</div>
                <div class="col-md-3 mt-3">🔷 Symfony</div>
                <div class="col-md-3 mt-3">🐘 PHP 8.2</div>
                <div class="col-md-3 mt-3">🐍 C++/Python</div>
                <div class="col-md-3 mt-3">🗄️ MariaDB</div>
                <div class="col-md-3 mt-3">🔗 REST API</div>
                <div class="col-md-3 mt-3">🐳 Docker</div>
                <div class="col-md-3 mt-3">📦 Git</div>
                <div class="col-md-3 mt-3">🐧 Linux</div>
                
            </div>
        </div>
    </section>

    <!-- Projects Preview -->

<!-- VR/XR Studio Section -->
<section>
        <div id="portfolio" class="container">
            <h2 class="text-center mb-4">Featured Projects</h2>

	    <div class="container" id="vr-studio">
     	         <h4 class="text-center mb-4">🥽 VR/XR Studio</h4>
       		 <div class="row">
                      <div class="col-lg-6 mb-4 mb-lg-0">
                          <div class="card h-100 shadow-sm">
                               <div class="card-body text-center">
                                    <span style="font-size: 4rem; display: block; margin-bottom: 1rem;">🎮</span>
                                    <h4>VR Accessories Design</h4>
                                    <p class="card-text">Custom VR accessories: foot tracking belt, NLP controller, omnidirectional treadmill.</p>
                               </div>
                          </div>
                      </div>
                      <div class="col-lg-6">
                           <div class="card h-100 shadow-sm">
                              <div class="card-body text-center">
                              <span style="font-size: 4rem; display: block; margin-bottom: 1rem;">🎯</span>
                              <h4>VR App Development</h4>
                              <p class="card-text">Full‑body character design, combat, football, meditation, and adventure games.</p>
                           </div>
                      </div>
                  </div>
             </div>
             <div class="text-center mt-4">
                 <a href="{{ path('app_apps', {category: 'vr'}) }}" class="btn btn-primary">
                     Explore VR/XR Projects
                 </a>
             </div>
       

<!-- Robotics & Automation Section -->
    <div class="container mt-5" id="robotics">
        <h4 class="text-center mb-4">🤖 Robotics & Automation</h4>
        <div class="row justify-content-center">
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <span style="font-size: 3rem; display: block; margin-bottom: 0.5rem;">🤖</span>
                        <h5>Robot Waiter</h5>
                        <p class="card-text small">Autonomous robot for coffee shops and restaurants.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <span style="font-size: 3rem; display: block; margin-bottom: 0.5rem;">📱</span>
                        <h5>Self-Service Tablets</h5>
                        <p class="card-text small">Android app on customer tablets for ordering and payments.</p>
                    </div>
                </div>
            </div>

                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">🤖  Binance Trading Bot</h5>
                            <p class="card-text">Automated cryptocurrency trading with Telegram alerts and real-time monitoring.</p>
                            <a href="/binance" class="btn btn-outline-primary">Learn more</a>
                        </div>
                    </div>
                </div>

        </div>
        <div class="text-center mt-3">
            <a href="{{ path('app_apps', {category: 'robotics'}) }}" class="btn btn-primary">
                View Robotics Projects
            </a>
        </div>
    </div>

    <div class="container">
        <h4 class="text-center mb-4">🛒  E-Commerce</h4>
            <div class="row">
                <div class="col-md-12 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">🛒 I Buy E‑commerce</h5>
                            <p class="card-text">Online marketplace with cart and payments.</p>
                            <a href="/pharmacy" class="btn btn-outline-primary">Learn more</a>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-4">
                   <a href="/apps" class="btn btn-primary">View All Projects</a>
                </div>
             </div>
     </div>
</div>
  </section>


    <!-- Contact + Socials (gray background) -->
    <section id="contact">
        <div class="contact-socials py-4 bg-secondary text-white mt-5">
        {#    <div class="container"> #}
                <div class="row mx-3">
                    <div class="col-12 col-md-6 text-center text-md-start mb-3 mb-md-0">
                        <h5>Contact</h5>
                        <address class="mb-0">
                            <strong>Development Engineering</strong><br>
                            Street Abdelkader M'hallah, Complex "EL HAJJAR" GF, Monastir, Tunisia<br>
                            <i class="fas fa-phone-alt me-1"></i> +216 98 411 682{# / +216 73 477 211#}<br>
                            <i class="fas fa-envelope me-1"></i> development.engineering.s@gmail.com
                        </address>
                    </div>
                    <div class="col-12 col-md-6 text-center text-md-end">
                        <h5>Follow us</h5>
                        <div class="social-icons">
                            <a href="https://github.com/hamda-chaouch" target="_blank" class="text-white me-3"><i class="fab fa-github fa-2x"></i></a>
