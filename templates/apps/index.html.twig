{# templates/apps/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Project Hub | Development Engineering{% endblock %}

{% block body %}
<a href="{{ path('home') }}" class="btn btn-secondary" style="position: fixed; top: 20px; left: 20px; z-index: 1000;">← Back to Home</a>

<div class="container">
    <h1>Welcome to Development Engineering</h1>
    <p>Select a project to manage or explore:</p>

    {# Group projects by category #}
    {% set categories = {
        '': 'All Projects',
        'vr': '🥽 VR/XR Studio',
        'robotics': '🤖 Robotics & Automation'
    } %}

    {# Default: show all if no category filter #}
    {% set activeCategory = app.request.query.get('category', '') %}

    <div class="category-filters mb-4">
        <a href="{{ path('app_apps') }}" class="btn {{ activeCategory == '' ? 'btn-primary' : 'btn-outline-secondary' }}">All Projects</a>
        <a href="{{ path('app_apps', {category: 'vr'}) }}" class="btn {{ activeCategory == 'vr' ? 'btn-primary' : 'btn-outline-secondary' }}">🥽 VR/XR Studio</a>
        <a href="{{ path('app_apps', {category: 'robotics'}) }}" class="btn {{ activeCategory == 'robotics' ? 'btn-primary' : 'btn-outline-secondary' }}">🤖 Robotics & Automation</a>
    </div>

    {% set filteredProjects = projects|filter(p => activeCategory == '' or (p.category|default('') == activeCategory)) %}

    <div class="row">
        {% for project in filteredProjects %}
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">
                            {% if project.icon %}
                                <i class="{{ project.icon }} text-primary me-2"></i>
                            {% endif %}
                            {{ project.name }}
                        </h5>
                        <p class="card-text">{{ project.description }}</p>

                        {# Status badge #}
                        {% if project.status is defined %}
                            <span class="badge 
                                {% if project.status == 'prototype' %}bg-warning
                                {% elseif project.status == 'research' %}bg-info
                                {% elseif project.status == 'production' %}bg-success
                                {% else %}bg-secondary{% endif %} 
                                mb-2">
                                {{ project.status|capitalize }}
                            </span>
                        {% endif %}

                        <a href="{{ project.path }}" class="btn btn-outline-primary" 
                           {% if project.external is defined and project.external %}target="_blank"{% endif %}>
                            Learn more
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <p class="text-muted">No projects found in this category.</p>
            </div>
        {% endfor %}
    </div>

    <div class="mt-5 p-4 bg-light rounded">
        <h3>🚀 Future Projects</h3>
        <ul class="list-unstyled">
            <li>🔬 Full‑body VR character project (foundation for all VR apps)</li>
            <li>📚 More VR experiences</li>
            <li>🤖 Advanced robotics integration</li>
        </ul>
    </div>
</div>

<style>
        body {
            background-image: url('/images/background.jpg');
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
        }
    .container {
        max-width: 1200px;
        margin: 50px auto;
        padding: 20px;
        text-align: center;
        background-color: rgba(255, 255, 255, 0.85);
        border-radius: 20px;
        min-height: 80vh;
    }
    .category-filters .btn {
        margin: 0 5px;
        border-radius: 30px;
        padding: 8px 24px;
    }
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
</style>
{% endblock %}
