{% macro render_achat_item(itemForm) %}
    <li class="row-item">
        {{ form_row(itemForm.produit) }}
        {{ form_row(itemForm.quantite) }}
        {{ form_row(itemForm.prix_unitaire_ht) }}
        {{ form_row(itemForm.tva_pourcentage) }}
        <button type="button" class="remove-item btn btn-danger btn-sm">Supprimer cet Article de cet Achat</button>
    </li>
{% endmacro %}

{{ form_start(form) }}
    <style>
        .form-group-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(2px);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        .form-group-card legend {
            font-size: 1.25rem;
            font-weight: 700;
            color: #2c3e50;
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
            display: inline-block;
            width: auto;
        }
        .form-label {
            font-weight: 600;
            color: #1e466e;
            margin-bottom: 0.25rem;
        }
       /* Dim help text */
       .form-text {
            font-size: 0.7rem;
            color: #aaa !important;
            opacity: 0.6;
            margin-top: 0.2rem;
            font-style: italic;
        }
    </style>

                {#  , {'attr': {'data-turbo': 'false'}}) }} #}
                {# This disables Turbo for that form, preventing the error:
     Turbo expects a redirect after form submission, but your controller 
     returns a rendered template (a 200 OK) when validation fails (no items with
     confirmed, partially received or received status #} 

    {#{ form_errors(form) }#}
    {# Display global form errors as Bootstrap alerts #}
    {% for error in form.vars.errors %}
        <div class="alert alert-danger">{{ error.message }}</div>
    {% endfor %}

    <fieldset class="mb-4 p-3 border rounded form-group-card">
        <legend class="fs-5 fw-bold text-primary">📄 Achat</legend>
            {{ form_row(form.reference) }}
            {{ form_row(form.date_achat) }}
            {{ form_row(form.fournisseur) }}
            {#{ form_row(form.tva_pourcentage) }#}
            {{ form_row(form.etat) }}
{#    </fieldset> #}

    <fieldset class="mb-4 p-3 border rounded form-group-card">
        <legend class="fs-5 fw-bold text-success">🛒 Produits achetés</legend>

            {# <h4 class="text-white">Ajouter Produits à votre Achat</h4> #}
            <ul id="achat-items-list" class="list-unstyled" data-prototype="{{ _self.render_achat_item(form.AchatItems.vars.prototype)|e('html_attr') }}">
                {% for item in form.AchatItems %}
                   {{ _self.render_achat_item(item) }}
                {% endfor %}
            </ul>
            <button type="button" id="add-item" class="btn btn-sm btn-primary">➕ Ajouter un autre Article pour cet Achat</button>
     </fieldset>
            <button class="btn btn-success">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}


<script>
    (function() {
        // Debug flag
        console.log('Script loaded');

        function initForm() {
            console.log('initForm called');
            const list = document.getElementById('achat-items-list');
            if (!list) {
                console.error('List #achat-items-list not found');
                return;
            }

            const addButton = document.getElementById('add-item');
            if (!addButton) {
                console.error('Add button #add-item not found');
                return;
            }

            // Remove any previous listener to avoid duplicates
            addButton.removeEventListener('click', addButton.clickHandler);
            // Define the handler
            addButton.clickHandler = function(e) {
                e.preventDefault();
                console.log('Add button clicked');
                if (list.children.length === 0) {
                    console.warn('No rows to clone');
                    return;
                }
                const firstRow = list.children[0];
                const newRow = firstRow.cloneNode(true);
                // Clear values
                newRow.querySelectorAll('input, select').forEach(field => {
                    if (field.type !== 'checkbox' && field.type !== 'radio') {
                        field.value = '';
                    } else {
                        field.checked = false;
                    }
                });
                // Remove custom data attributes
                newRow.querySelectorAll('[data-product-listener], [data-remove-listener]').forEach(el => {
                    el.removeAttribute('data-product-listener');
                    el.removeAttribute('data-remove-listener');
                });
                list.appendChild(newRow);
                reindexRows(); // <-- important: renumber all rows

                // Re‑attach product listeners and remove listener
                attachProductListener(newRow);
                attachRemoveListener(newRow);
                // Re‑apply supplier filter if needed
                const supplierSelect = document.querySelector('select[name$="[fournisseur]"]');
                if (supplierSelect && supplierSelect.value) {
                    updateProductOptions(newRow, supplierSelect.value);
                }
            };
            addButton.addEventListener('click', addButton.clickHandler);
            console.log('Add button listener attached');

            // Helper functions (same as before)
            function attachProductListener(row) {
                const productSelect = row.querySelector('select[id$="_produit"]');
                if (productSelect && !productSelect.hasAttribute('data-product-listener')) {
                    productSelect.setAttribute('data-product-listener', 'true');
                    productSelect.addEventListener('change', function() {
                        const selectedOption = this.options[this.selectedIndex];
                        const price = selectedOption.getAttribute('data-price') || 0;
                        const priceInput = row.querySelector('input[id$="_prix_unitaire_ht"]');
                        if (priceInput) priceInput.value = price;
                        const tva = selectedOption.getAttribute('data-tva') || 0;
                        const tvaInput = row.querySelector('input[id$="_tva_pourcentage"]');
                        if (tvaInput) tvaInput.value = tva;
                    });
                }
            }

            function attachRemoveListener(row) {
                const removeBtn = row.querySelector('.remove-item');
                if (removeBtn && !removeBtn.hasAttribute('data-remove-listener')) {
                    removeBtn.setAttribute('data-remove-listener', 'true');
                    removeBtn.addEventListener('click', () => {
                        if (list.children.length > 1) {
                            row.remove();
                        } else {
                            row.querySelectorAll('input, select').forEach(field => {
                                if (field.type !== 'checkbox' && field.type !== 'radio') {
                                    field.value = '';
                                } else {
                                    field.checked = false;
                                }
                            });
                        }
                    });
                }
            }

            function updateProductOptions(row, supplierId) {
                let productSelect = row.querySelector('select[id$="_produit"]');
                if (!productSelect) return;
                let currentValue = productSelect.value; //store current product ID
                fetch('/pharmacy/achat/get-products/' + supplierId)
                    .then(response => response.json())
                    .then(products => {
                        // Clear and rebuild options
                        productSelect.innerHTML = '<option value="">Choisit un produit</option>';
                        products.forEach(product => {
                            let option = new Option(product.designation, product.id);
                            option.setAttribute('data-price', product.prix_unitaire_ht);
                            option.setAttribute('data-tva', product.tva_pourcentage);
                            productSelect.appendChild(option);
                        });
                        // Restore previous selection if possible
                        if (currentValue){
                                    productSelect.value = currentValue;

                        }

                    })
                    .catch(err => console.error('Error loading products:', err));
            }

            function reindexRows() {
                const list = document.getElementById('achat-items-list');
                for (let i = 0; i < list.children.length; i++) {
                    const row = list.children[i];
                    // Update name attributes of all input/select fields
                    row.querySelectorAll('input, select').forEach(field => {
                        field.name = field.name.replace(/\[[0-9]+\]/, `[${i}]`);
                    });
                    // Also update ids if you rely on them (optional)
                    row.querySelectorAll('[id]').forEach(field => {
                        field.id = field.id.replace(/_[0-9]+_/, `_${i}_`);
                    });
                }
            }


            // Attach listeners to existing rows
            for (let row of list.children) {
                attachProductListener(row);
                attachRemoveListener(row);
            }

            // Supplier dropdown listener
            const supplierSelect = document.querySelector('select[name$="[fournisseur]"]');
            if (supplierSelect && !supplierSelect.hasAttribute('data-supplier-listener')) {
                supplierSelect.setAttribute('data-supplier-listener', 'true');
                supplierSelect.addEventListener('change', function() {
                    const supplierId = this.value;
                    if (!supplierId) return;
                    for (let row of list.children) {
                        updateProductOptions(row, supplierId);
                    }
                });
                if (supplierSelect.value) {
                    supplierSelect.dispatchEvent(new Event('change'));
                }
            }
        }

        // Handle Turbo and normal page loads
        if (typeof Turbo !== 'undefined') {
            document.addEventListener('turbo:load', () => {
                console.log('turbo:load fired');
                initForm();
            });
        } else {
            document.addEventListener('DOMContentLoaded', initForm);
        }
        // Also run immediately if DOM already loaded
        if (document.readyState !== 'loading') {
            initForm();
        }
    })();


