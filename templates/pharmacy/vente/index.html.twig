{% extends 'pharmacyBase.html.twig' %}

{% block page_title %}Gestion des Ventes{% endblock %}

{% block content %}
    <div class="text-white d-flex justify-content-between align-items-center mb-3">

        <h1>Liste des Ventes</h1>
        <a href="{{ path('app_pharmacy_vente_new') }}" class="btn btn-primary">Créer nouveau</a>

    </div>

    <li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

    <div class="table-responsive">
      <table class="table table-striped table-hover table-sm border-2 rounded-3 overflow-hidden shadow-sm">
        <thead class="table-light border-bottom-0">
            <tr class="border-0">
                <th>Id</th>
                <th>Reference</th>
                <th>Date_vente</th>
                <th>Total_ht</th>
                <th>Total_tva</th>
                <th>Total_ttc</th>
                <th>Etat</th>
{#                <th>Tva_pourcentage</th>  #}
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for vente in ventes %}
            <tr>
                <td>{{ vente.id }}</td>
                <td>{{ vente.reference }}</td>
                <td>{{ vente.dateVente ? vente.dateVente|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ vente.totalHt }}</td>
                <td>{{ vente.totalTva }}</td>
                <td>{{ vente.totalTtc }}</td>
                <td>{{ vente.etat }}</td>
{#                <td>{{ vente.tvaPourcentage }}</td>  #}
                <td>
                    <a href="{{ path('app_pharmacy_vente_show', {'id': vente.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    {#<a href="{{ path('app_pharmacy_vente_edit', {'id': vente.id}) }}" class="btn btn-sm btn-warning">edit</a>#}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">Aucun enregistrement trouvé!</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a>
{% endblock %}
