
{% extends 'pharmacyBase.html.twig' %}

{% block page_title %}
Rima Parapharmacy Manager
<p class="text-muted small mb-0">Tableau de bord - Vue d'ensemble de votre activité</p>

{% endblock %}

{% block content %}

<!-- Cash Summary Cards (same style as stock status card) -->
<div class="card mb-4 shadow-sm border-success">
    <div class="card-body">
        <h5 class="card-title"><i class="fas fa-cash-register text-success me-2"></i> Caisse</h5>
        <div class="row mt-3">
            <div class="col-md-3 text-center mb-3 mb-md-0">
                <i class="fas fa-calendar-day fa-2x text-primary"></i>
                <h6 class="mt-2 fw-bold">Journalière</h6>
                {# <small class="text-muted">Ventes du jour</small> #}
                <div class="mt-1">
                    <span class="badge bg-primary fs-6">{{ dailyTotal|number_format(2, ',', ' ') }} Dt</span>
                </div>
                <small class="text-muted">Aujourd'hui</small>
            </div>
            <div class="col-md-3 text-center mb-3 mb-md-0">
                <i class="fas fa-calendar-week fa-2x text-success"></i>
                <h6 class="mt-2 fw-bold">Mensuelle</h6>
                {# <small class="text-muted">Ventes du mois</small> #}
                <div class="mt-1">
                    <span class="badge bg-success fs-6">{{ monthlyTotal|number_format(2, ',', ' ') }} Dt</span>
                </div>
                <small class="text-muted">Ce mois</small>
            </div>
            <div class="col-md-3 text-center mb-3 mb-md-0">
                <i class="fas fa-calendar-alt fa-2x text-warning"></i>
                <h6 class="mt-2 fw-bold">Annuelle</h6>
                {# <small class="text-muted">Ventes de l'année</small> #}
                <div class="mt-1">
                    <span class="badge bg-warning fs-6">{{ yearlyTotal|number_format(2, ',', ' ') }} Dt</span>
                </div>
                <small class="text-muted">Cette année</small>
            </div>

            <div class="col-md-3 text-center">
              <div class="border-start-md ps-md-3">
                <i class="fas fa-chart-line fa-2x text-danger"></i>
                <h6 class="mt-2 fw-bold">Gain Journalier</h6>
                <div class="mt-1">
                    <span class="badge bg-danger fs-6">{{ dailyProfit|number_format(2, ',', ' ') }} Dt</span>
                </div>
                <small class="text-muted">(Ventes - Achats)</small>
              </div>
            </div>
        </div>
    </div>
</div>

<!-- Stock status card -->
            <div class="card mb-4 shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-check-circle text-success"></i> Votre stock en bon état</h5>
                    <p class="card-text">Aucune rupture de stock. Pensez à vérifier les produits proches de péremption.</p>
                </div>
</div>

{# Alerte péremption #}
<div class="card mb-4 shadow-sm border-danger">
    <div class="card-header bg-danger text-white fw-bold">
        <i class="fas fa-exclamation-triangle me-2"></i> Alertes péremption
    </div>
    <div class="card-body">
        {% if expiredProducts|length > 0 %}
            <h6 class="text-danger">⚠️ Produits EXPIRÉS</h6>
            <ul>
                {% for product in expiredProducts %}
                    <li>
                        <strong>{{ product.designation }}</strong> – Expiré le {{ product.dateExpiration|date('d/m/Y') }}
                        <a href="{{ path('app_pharmacy_stock_edit', {'id': product.id}) }}" class="btn btn-sm btn-warning ms-2">Mettre à jour</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if soonExpiringProducts|length > 0 %}
            <h6 class="text-warning mt-3">⚠️ Produits proches de l'expiration (dans les 30 jours)</h6>
            <ul>
                {% for product in soonExpiringProducts %}
                    <li>
                        <strong>{{ product.designation }}</strong> – Expire le {{ product.dateExpiration|date('d/m/Y') }}
                        <a href="{{ path('app_pharmacy_stock_edit', {'id': product.id}) }}" class="btn btn-sm btn-info ms-2">Voir</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {% if expiredProducts|length == 0 and soonExpiringProducts|length == 0 %}
            <p class="text-success mb-0">Aucune alerte de péremption.</p>
        {% endif %}
    </div>
</div>



