{% extends 'pharmacyBase.html.twig' %}

{% block page_title %}Consulter les Avoirs!{% endblock %}

{% block content %}

<h1 class="text-white">Avoirs</h1>

<li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

<table class="table table-striped">
    <thead>
        <tr>
            <th>N° avoir</th>
            <th>Date</th>
            <th>Facture liée</th>
            <th>Montant</th>
            <th>Motif</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for cn in credit_notes %}
        <tr>
            <td>{{ cn.creditNumber }}</td>
            <td>{{ cn.date|date('d/m/Y') }}</td>
            <td>{{ cn.invoice.invoiceNumber }}</td>
            <td>{{ cn.amount|number_format(2, ',', ' ') }} €</td>
            <td>{{ cn.reason }}</td>
            <td><a href="{{ path('app_credit_note_show', {'id': cn.id}) }}" class="btn btn-sm btn-info">Voir</a></td>
        </tr>
        {% endfor %}
    </tbody>
</table>
<li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

{% endblock %}
