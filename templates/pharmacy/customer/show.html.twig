{% extends 'pharmacyBase.html.twig' %}

{% block page_title %}Afficher les Détails du Client {{ customer.raisonSocial }}{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h1>Détails</h1>
        <a href="{{ path('app_pharmacy_customer_new') }}" class="btn btn-primary">Créer nouveau</a>
    </div>

    <table class="table table-striped">
        <tbody>
{#            <tr>
                <th>Id</th>
                <td>{{ customer.id }}</td>
            </tr> #}
            <tr>
                <th>RaisonSocial</th>
                <td>{{ customer.raisonSocial }}</td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ customer.adresse }}</td>
            </tr>
            <tr>
                <th>Responsable</th>
                <td>{{ customer.responsable }}</td>
            </tr>
            <tr>
                <th>Gsm</th>
                <td>{{ customer.gsm }}</td>
            </tr>
            <tr>
                <th>Telephone</th>
                <td>{{ customer.telephone }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ customer.email }}</td>
            </tr>
            <tr>
                <th>Actions</th>
                <td>
                    <a href="{{ path('app_pharmacy_customer_edit', {'id': customer.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                    {{ include('pharmacy/customer/_delete_form.html.twig') }}
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_pharmacy_customer_index') }}" class="btn btn-secondary">Retour à la Liste</a>

{% endblock %}
