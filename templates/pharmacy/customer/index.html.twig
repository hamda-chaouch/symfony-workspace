{% extends 'pharmacyBase.html.twig' %}

{% block page_title %}Gestion des Clients{% endblock %}

{% block content %}
    <div class="text-white d-flex justify-content-between align-items-center mb-3">
        <h1>Liste des Clients</h1>
        <a href="{{ path('app_pharmacy_customer_new') }}" class="btn btn-primary">Créer nouveau</a>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-hover table-sm border-2 rounded-3 overflow-hidden shadow-sm">
        <thead class="table-light border-bottom-0">
            <tr class="border-0">                <th>Id</th>
                <th>RaisonSocial</th>
                <th>Adresse</th>
                <th>Responsable</th>
                <th>Gsm</th>
                <th>Telephone</th>
                <th>Email</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for customer in customers %}
            <tr>
                <td>{{ customer.id }}</td>
                <td>{{ customer.raisonSocial }}</td>
                <td>{{ customer.adresse }}</td>
                <td>{{ customer.responsable }}</td>
                <td>{{ customer.gsm }}</td>
                <td>{{ customer.telephone }}</td>
                <td>{{ customer.email }}</td>
                <td>
                    <a href="{{ path('app_pharmacy_customer_show', {'id': customer.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    <a href="{{ path('app_pharmacy_customer_edit', {'id': customer.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">Aucun enregistrement</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a>
{% endblock %}
