{% extends 'pharmacyBase.html.twig' %}

{% block page_title %}Gestion du Stock{% endblock %}

{% block content %}
{#
    <div class="text-white d-flex justify-content-between align-items-center mb-3">
        <h1>Liste des produits</h1>
        <a href="{{ path('app_pharmacy_stock_new') }}" class="btn btn-primary">Créer nouveau</a>
    </div>

    <div class="row justify-content-center mb-4">
      <div class="col-md-6">
        <div class="alert alert-info text-center py-2 mb-0 border-0">
            <i class="fas fa-list-ul me-2"></i>
            <strong>{{ stocks|length }}</strong> produits(s) au total
        </div>
      </div>
    </div>
#}

<div class="mb-4">
    <div class="d-flex align-items-center gap-lg-3 p-3 bg-light rounded-3 border-start border-primary border-4">
        <div class="col-1 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
            <i class="fas fa-list-ul"></i>
        </div>
        <div class="col-4">
            <h2 class="mb-0 fw-bold text-dark">Liste des Produits</h2>
            {#<span class="text-muted small">{{ stocks|length }} enregistrement(s)</span>#}
        </div>
        <div class="col-5 {#justify-content-center mb-4#}">
               <div class="alert alert-info text-center py-2 mb-0 border-0">
                   <i class="fas fa-list-ul me-2"></i>
                   <strong>{{ stocks|length }}</strong> produit(s) au total
               </div>
        </div>
        <div class="col-2">
            <a href="{{ path('app_pharmacy_stock_new') }}" class="btn btn-primary">Créer nouveau</a>
        </div>
    </div>
</div>


    <li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

    {# ---------- FILTER BAR ---------- #}
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body py-3">
            <form method="get" action="{{ path('app_pharmacy_stock_index') }}" class="row g-2 align-items-end">

                {# --- Row 1: search, category, supplier, status, expiration --- #}

                {# Search #}
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">
                        <i class="fas fa-search me-1"></i> Recherche
                    </label>
                    <input type="text" name="search" class="form-control form-control-sm"
                           placeholder="Désignation ou référence..."
                           value="{{ filters.search }}">
                </div>

                {# Category #}
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">Catégorie</label>
                    <select name="category" class="form-select form-select-sm">
                        <option value="">Toutes</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}" {% if filters.category == cat.id %}selected{% endif %}>
                                {{ cat.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Supplier #}
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">Fournisseur</label>
                    <select name="supplier" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        {% for f in fournisseurs %}
                            <option value="{{ f.id }}" {% if filters.supplier == f.id %}selected{% endif %}>
                                {{ f.raisonSocial }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                {# Stock status #}
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">État du stock</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        <option value="ok"   {% if filters.status == 'ok' %}selected{% endif %}>✅ En stock</option>
                        <option value="low"  {% if filters.status == 'low' %}selected{% endif %}>⚠️ Stock faible</option>
                        <option value="out"  {% if filters.status == 'out' %}selected{% endif %}>❌ Rupture</option>
                        <option value="over" {% if filters.status == 'over' %}selected{% endif %}>🔺 Surstock</option>
                    </select>
                </div>

                {# Expiration #}
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">Péremption</label>
                    <select name="expiration" class="form-select form-select-sm">
                        <option value="">Toutes</option>
                        <option value="expired" {% if filters.expiration == 'expired' %}selected{% endif %}>⚠️ Périmés</option>
                        <option value="soon"    {% if filters.expiration == 'soon' %}selected{% endif %}>⏳ Bientôt (30 j)</option>
                        <option value="none"    {% if filters.expiration == 'none' %}selected{% endif %}>— Sans date</option>
                    </select>
                </div>

                {# Buttons #}
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-fill" title="Filtrer">
                        <i class="fas fa-filter"></i>
                    </button>
                    <a href="{{ path('app_pharmacy_stock_index') }}" class="btn btn-outline-secondary btn-sm flex-fill" title="Réinitialiser">
                        <i class="fas fa-times"></i>
                    </a>
                </div>

                {# --- Row 2: quantity range --- #}
                {# ← NEW: filter by quantity (e.g., 0 to find out-of-stock products) #}
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">
                        <i class="fas fa-cubes me-1"></i> Quantité (min – max)
                    </label>
                    <div class="input-group input-group-sm">
                        <input type="number" name="qty_min" class="form-control"
                               placeholder="Min (ex: 0)" min="0"
                               value="{{ filters.qty_min }}">
                        <span class="input-group-text">→</span>
                        <input type="number" name="qty_max" class="form-control"
                               placeholder="Max" min="0"
                               value="{{ filters.qty_max }}">
                    </div>
                </div>

            </form>
        </div>
    </div>

    {# ---------- COUNTER ---------- #}
    <div class="row justify-content-center mb-4">
        <div class="col-md-6">
            <div class="alert alert-info text-center py-2 mb-0 border-0">
                <i class="fas fa-boxes-stacked me-2"></i>
                <strong>{{ stocks|length }}</strong> produit(s) trouvé(s)
                {# ← UPDATED: also check qty_min / qty_max to display "(filtré)" #}
                {% if filters.search or filters.category or filters.supplier or filters.status or filters.expiration or filters.qty_min is not null or filters.qty_max is not null %}
                    <span class="text-muted small ms-2">(filtré)</span>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="table-responsive">
      <table class="table table-striped table-hover table-sm border-2 rounded-3 overflow-hidden shadow-sm">
        <thead class="table-light border-bottom-0">
            <tr class="border-0">
                <th>Actions</th>
                <th>Designation</th>
                <th>Reference</th>
                <th>Date de péremption</th>
                <th>Prix d'Achat TTC</th>
                <th>Prix de Gros</th>
                <th>Prix de Vente Publique</th>
                {#<th>% TVA</th>#}
                <th>Quantite</th>
                <th>Quantite_min</th>
                <th>Quantite_max</th>
                <th>Description</th>
                <th>Category</th>
                <th>Supplier</th>
            </tr>
        </thead>
        <tbody>
        {% for stock in stocks %}
            <tr>
                <td>
                  <div class="btn-group btn-group-sm" role="group">
                    <a href="{{ path('app_pharmacy_stock_show', {'id': stock.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    <a href="{{ path('app_pharmacy_stock_edit', {'id': stock.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                  </div>
                </td>
                <td>{{ stock.designation }}</td>
                <td>{{ stock.reference }}</td>
                <td>{{ stock.dateExpiration ? stock.dateExpiration|date('d/m/Y') : '—' }}</td>
                <td>{{ stock.prixAchat }}</td>
                <td>{{ stock.prixGros }}</td>
                <td>{{ stock.prixDetail }}</td>
                {#<td>{{ stock.tvaPourcentage }}</td>#}
                {#<td>{{ stock.quantite }}</td> #}
                <td>
                    {% if stock.quantite == 0 %}
                        <span class="badge bg-danger">0</span>
                    {% elseif stock.quantiteMin is not null and stock.quantite <= stock.quantiteMin %}
                        <span class="badge bg-warning text-dark">{{ stock.quantite }}</span>
                    {% elseif stock.quantiteMax is not null and stock.quantite >= stock.quantiteMax %}
                        <span class="badge bg-info text-dark">{{ stock.quantite }}</span>
                    {% else %}
                        <span class="badge bg-success">{{ stock.quantite }}</span>
                    {% endif %}
                </td>
                <td>{{ stock.quantiteMin }}</td>
                <td>{{ stock.quantiteMax }}</td>
                <td>{{ stock.description }}</td>
                <td>{{ stock.categorie ? stock.categorie.nom : '-' }}</td>
                <td>{{ stock.fournisseur ? stock.fournisseur.raisonSocial : '-' }}</td>
            </tr>
        {% else %}
            <tr>
                {#<td colspan="11">Aucun enregistrement</td>#}
            <tr>
                <td colspan="13" class="text-center text-muted py-4">
                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                    Aucun produit ne correspond à vos critères.
                </td>
            </tr>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>
{% endblock %}
