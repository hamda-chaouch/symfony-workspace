{% extends 'pharmacyBase.html.twig' %}

{% block page_title %}Gestion du Stock{% endblock %}

{% block content %}
{#
    <div class="text-white d-flex justify-content-between align-items-center mb-3">
        <h1>Liste des produits</h1>
        <a href="{{ path('app_pharmacy_stock_new') }}" class="btn btn-primary">Créer nouveau</a>
    </div>

    <div class="row justify-content-center mb-4">
      <div class="col-md-6">
        <div class="alert alert-info text-center py-2 mb-0 border-0">
            <i class="fas fa-list-ul me-2"></i>
            <strong>{{ stocks|length }}</strong> produits(s) au total
        </div>
      </div>
    </div>
#}

<div class="mb-4">
    <div class="d-flex align-items-center gap-lg-3 p-3 bg-light rounded-3 border-start border-primary border-4">
        <div class="col-1 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
            <i class="fas fa-list-ul"></i>
        </div>
        <div class="col-4">
            <h2 class="mb-0 fw-bold text-dark">Liste des Produits</h2>
            {#<span class="text-muted small">{{ stocks|length }} enregistrement(s)</span>#}
        </div>
        <div class="col-5 {#justify-content-center mb-4#}">
               <div class="alert alert-info text-center py-2 mb-0 border-0">
                   <i class="fas fa-list-ul me-2"></i>
                   <strong>{{ stocks|length }}</strong> produit(s) au total
               </div>
        </div>
        <div class="col-2">
            <a href="{{ path('app_pharmacy_stock_new') }}" class="btn btn-primary">Créer nouveau</a>
        </div>
    </div>
</div>


    <li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

    <div class="table-responsive">
      <table class="table table-striped table-hover table-sm border-2 rounded-3 overflow-hidden shadow-sm">
        <thead class="table-light border-bottom-0">
            <tr class="border-0">
                <th>Actions</th>
                <th>Designation</th>
                <th>Reference</th>
                <th>Date de péremption</th>
                <th>Prix d'Achat TTC</th>
                <th>Prix de Gros</th>
                <th>Prix de Vente Publique</th>
                {#<th>% TVA</th>#}
                <th>Quantite</th>
                <th>Quantite_min</th>
                <th>Quantite_max</th>
                <th>Description</th>
                <th>Category</th>
                <th>Supplier</th>
            </tr>
        </thead>
        <tbody>
        {% for stock in stocks %}
            <tr>
                <td>
                  <div class="btn-group btn-group-sm" role="group">
                    <a href="{{ path('app_pharmacy_stock_show', {'id': stock.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    <a href="{{ path('app_pharmacy_stock_edit', {'id': stock.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                  </div>
                </td>
                <td>{{ stock.designation }}</td>
                <td>{{ stock.reference }}</td>
                <td>{{ stock.dateExpiration ? stock.dateExpiration|date('d/m/Y') : '—' }}</td>
                <td>{{ stock.prixAchat }}</td>
                <td>{{ stock.prixGros }}</td>
                <td>{{ stock.prixDetail }}</td>
                {#<td>{{ stock.tvaPourcentage }}</td>#}
                <td>{{ stock.quantite }}</td>
                <td>{{ stock.quantiteMin }}</td>
                <td>{{ stock.quantiteMax }}</td>
                <td>{{ stock.description }}</td>
                <td>{{ stock.categorie ? stock.categorie.nom : '-' }}</td>
                <td>{{ stock.fournisseur ? stock.fournisseur.raisonSocial : '-' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">Aucun enregistrement</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>
{% endblock %}
