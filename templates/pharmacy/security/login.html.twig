{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Connexion</h4>
                </div>
                <div class="card-body">

                    <form method="post">
                        {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">
            </div>
        {% endif %}
                        {#% if csrf_token_intention %#}
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        {#% endif %#}

                        <h1 class="h3 mb-3 font-weight-normal">Please sign in</h1> 

                        <div class="mb-3">
                            <label for="username" class="form-label fw-semibold">Nom d'utilisateur</label>
                            <input type="text" id="username" name="_username" value="{{ last_username }}" class="form-control" autocomplete="username" required autofocus>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label fw-semibold">Mot de passe</label>
                            <input type="password" id="password" name="_password" class="form-control" autocomplete="current-password" required>
                        </div>

{#                        <div class="mb-3 form-check">
                            <input type="checkbox" id="remember_me" name="_remember_me" class="form-check-input">
                            <label for="remember_me" class="form-check-label">Se souvenir de moi</label>
                        </div> #}

                        <button type="submit" class="btn btn-primary w-100">Se connecter</button>
                    </form>
                </div>
                {#<div class="card-footer text-center">#}
                {#    <small>Pas encore de compte ? <a href="{{ path('app_register') }}">Inscrivez-vous</a></small>#}
                {#</div>#}
            </div>
        </div>
    </div>
</div>






        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div> #}


 <style>
        body {
            background-image: url('{{ asset('images/paraback.png') }}') !important;
            background-size: cover;
            background-attachment: fixed;
            background-color: transparent;
        }
        .card {
            background-color: rgba(255, 255, 255, 0.9);
        }
 </style>

{% endblock %}

