{% extends 'pharmacyBase.html.twig' %}

{% block page_title %}Category index{% endblock %}

{% block content %}
{# 
    <div class="text-white d-flex justify-content-between align-items-center mb-3">

        <h1>Category index</h1> 
        <a href="{{ path('app_pharmacy_category_new') }}" class="btn btn-primary">Créer nouveau</a>
    </div>

    <div class="row justify-content-center mb-4">
      <div class="col-md-6">
        <div class="alert alert-info text-center py-2 mb-0 border-0">
            <i class="fas fa-tags me-2"></i>
            <strong>{{ categories|length }}</strong> catégorie(s) au total
        </div>
      </div>
    </div>
#}
<div class="mb-4">
    <div class="d-flex align-items-center gap-lg-3 p-3 bg-light rounded-3 border-start border-primary border-4">
        <div class="col-1 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
            <i class="fas fa-list-ul"></i>
        </div>
        <div class="col-4">
            <h2 class="mb-0 fw-bold text-dark">Liste des Categories</h2>
            {#<span class="text-muted small">{{ categories|length }} enregistrement(s)</span>#}
        </div>
        <div class="col-5 {#justify-content-center mb-4#}">
               <div class="alert alert-info text-center py-2 mb-0 border-0">
                   <i class="fas fa-tags me-2"></i>
                   <strong>{{ categories|length }}</strong> categorie(s) au total
               </div>
        </div>
        <div class="col-2">
            <a href="{{ path('app_pharmacy_category_new') }}" class="btn btn-primary">Créer nouveau</a>
        </div>
    </div>
</div>


    <li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

    <div class="table-responsive">
      <table class="table table-striped table-hover table-sm border-2 rounded-3 overflow-hidden shadow-sm">
        <thead class="table-light border-bottom-0">
            <tr class="border-0">               
                <th>Id</th>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.nom }}</td>
                <td>
                    <a href="{{ path('app_pharmacy_category_show', {'id': category.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    <a href="{{ path('app_pharmacy_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucun enregistrement</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

{% endblock %}
