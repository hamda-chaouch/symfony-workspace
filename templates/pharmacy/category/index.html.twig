{% extends 'pharmacyBase.html.twig' %}

{% block page_title %}Category index{% endblock %}

{% block content %}
    <div class="text-white d-flex justify-content-between align-items-center mb-3">

        <h1>Category index</h1> 
        <a href="{{ path('app_pharmacy_category_new') }}" class="btn btn-primary">Créer nouveau</a>
    </div>

    <li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

    <div class="table-responsive">
      <table class="table table-striped table-hover table-sm border-2 rounded-3 overflow-hidden shadow-sm">
        <thead class="table-light border-bottom-0">
            <tr class="border-0">                <th>Id</th>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.nom }}</td>
                <td>
                    <a href="{{ path('app_pharmacy_category_show', {'id': category.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    <a href="{{ path('app_pharmacy_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucun enregistrement</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

{% endblock %}
