{% extends 'pharmacyBase.html.twig' %}

{% block page_title %}Consulter les Factures!{% endblock %}

{% block content %}
{#
<h1 class="text-white">Factures</h1>

<div class="row justify-content-center mb-4">
    <div class="col-md-6">
        <div class="alert alert-info text-center py-2 mb-0 border-0">
            <i class="fas fa-file-invoice me-2"></i>
            <strong>{{ invoices|length }}</strong> avoir(s) au total
        </div>
    </div>
</div>
#}
<div class="mb-4">
    <div class="d-flex align-items-center gap-lg-3 p-3 bg-light rounded-3 border-start border-primary border-4">
        <div class="col-1 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
            <i class="fas fa-list-ul"></i>
        </div>
        <div class="col-4">
            <h2 class="mb-0 fw-bold text-dark">Liste des Factures</h2>
            {#<span class="text-muted small">{{ invoices|length }} enregistrement(s)</span>#}
        </div>
        <div class="col-5 {#justify-content-center mb-4#}">
               <div class="alert alert-info text-center py-2 mb-0 border-0">
                   <i class="fas fa-file-invoice me-2"></i>
                   <strong>{{ invoices|length }}</strong> facture(s) au total
               </div>
        </div>
    </div>
</div>

<li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

<table class="table table-striped">
    <thead>
        <tr>
            <th>N° facture</th>
            <th>Date</th>
            <th>Total TTC</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for inv in invoices %}
        <tr>
            <td>{{ inv.invoiceNumber }}</td>
            <td>{{ inv.date|date('d/m/Y') }}</td>
            <td>{{ inv.totalTtc|number_format(2, ',', ' ') }} €</td>
            <td>{{ inv.status }}</td>
            <td><a href="{{ path('app_invoice_show', {'id': inv.id}) }}" class="btn btn-sm btn-info">Voir</a></td>
        </tr>
        {% endfor %}
    </tbody>
</table>
<li><a href="{{ path('pharmacy_dashboard') }}" class="btn btn-secondary">← Retour à l'Accueil</a></li>

{% endblock %}
