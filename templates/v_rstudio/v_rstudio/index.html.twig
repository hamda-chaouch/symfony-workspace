{% extends 'base.html.twig' %}

{% block title %}VR/XR Studio | Development Engineering{% endblock %}

{% block body %}
<div class="container">
    <a href="{{ path('app_apps') }}" class="btn btn-secondary mb-4">← Back to Projects</a>

    <div class="text-center mb-5">
        <span style="font-size: 5rem;">🥽</span>
        <h1>VR/XR Studio</h1>
        <p class="lead">Immersive experiences, custom accessories, and full‑body VR.</p>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">🎮 VR Accessories</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-3">
						    <i class="fas fa-shoe-prints text-primary me-2"></i>
                            <strong>🦶 Foot Tracking Belt</strong>
                            <p class="small text-muted">Belt with Step detection to replace joystick movement. Full foot detection for 100% immersion.</p>
							<span class="badge bg-warning mb-2">PROTOTYPE</span>
                        </li>
                        <li class="mb-3">
						    <i class="fas fa-microchip text-primary me-2"></i>
                            <strong>🧠 NLP Controller</strong>
                            <p class="small text-muted">Natural Language Processing to replace traditional VR controllers (combined with steps detection Belt).</p>
							<span class="badge bg-info mb-2">RESEARCH</span>
                        </li>
                        <li class="mb-3">
						    <i class="fas fa-running text-primary me-2"></i>
                            <strong>🏃 Omni‑Directional Treadmill</strong>
                            <p class="small text-muted">VR treadmill solution integrated with the Foot Tracking Belt for complete locomotion freedom.</p>
							<span class="badge bg-warning mb-2">PROTOTYPE</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">🎯 VR Apps</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-3">
						    <i class="fas fa-spa text-primary me-2"></i>
                            <strong>🧘 VR Meditation</strong>
                            <p class="small text-muted">Immersive relaxation and mindfulness experiences in Virtual Reality.</p>
                        </li>
                        <li class="mb-3">
						    <i class="fas fa-monkey text-primary me-2"></i>
                            <strong>🦍 Gorilla – A New Journey</strong>
                            <p class="small text-muted">Adventure mode version of Gorilla Tag – climb, run, and explore in VR.</p>
                        </li>
                        <li class="mb-3">
						    <i class="fas fa-fist-raised text-primary me-2"></i>
                            <strong>⚔️ VR Combat Arena</strong>
                            <p class="small text-muted">Full‑body combat VR app. Combined with foot tracking for 100% immersion.</p>
                        </li>
                        <li class="mb-3">
						    <i class="fas fa-futbol text-primary me-2"></i>
                            <strong>⚽ VR Football</strong>
                            <p class="small text-muted">Realistic football with foot tracking for kicking and movement.</p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
